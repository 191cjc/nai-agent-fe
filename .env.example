# API auth, image MCP adapter, public tag search and isolated Codex advice.
# Do not commit .env.local. Preserve existing .env.local values when updating it.
# Optional SQLite FILE path (not a URL or server). Backend defaults to
# ./var/data/novelai.sqlite3 relative to the working directory.
NAI_SQLITE_PATH=./var/data/novelai.sqlite3
# User access tokens are generated by the admin command, not configured here.
# Only their SHA-256 digests are stored in SQLite; no token-hash key is needed.

# Exact browser origin for cookie/CSRF checks; production requires HTTPS.
NAI_PUBLIC_ORIGIN=

# NovelAI MCP generation: browser never sees this server-managed Bearer token.
NAI_NOVELAI_MCP_URL=https://www.fsstudy.com.cn/novel-ai-v5
NAI_NOVELAI_MCP_TOKEN=
# Codex advice uses the pinned Python SDK and project-local CLI against the
# official default endpoint. Explicit API-key configuration enables advice;
# the key is passed to a per-turn isolated CLI login through stdin, not placed
# in the SDK child environment. An inherited CLI login is ignored.
NAI_CODEX_API_KEY=

# DanbooruSearch key is optional if the provider allows anonymous searches.
NAI_DANBOORU_SEARCH_API_URL=https://sakizuki-danboorusearch.hf.space/api
NAI_DANBOORU_SEARCH_API_KEY=
