# Installed as root-owned mode-0600 /etc/novelai/api.env; fill secrets there.
NAI_PUBLIC_ORIGIN=https://www.firesoul.cn
NAI_SQLITE_PATH=/var/lib/novelai/novelai.sqlite3

# Enable paid providers only after configuring their credentials privately.
NAI_NOVELAI_MCP_URL=https://www.fsstudy.com.cn/novel-ai-v5
NAI_NOVELAI_MCP_TOKEN=
NAI_CODEX_API_KEY=

# Optional authenticated DanbooruSearch access.
NAI_DANBOORU_SEARCH_API_URL=https://sakizuki-danboorusearch.hf.space/api
NAI_DANBOORU_SEARCH_API_KEY=
